# Copy to demo/.env.live (gitignored) and fill in what you have. Blank lines are fine:
# any tool without a key stays a stand-in, and check-keys.mjs says so.
#
#   cp demo/live.env.example demo/.env.live

# --- Blaxel: the sandbox (required for a real run)
BL_API_KEY=
BL_WORKSPACE=
AHD_SANDBOX_IMAGE=blaxel/base-image:latest

# --- Anthropic: the resolver and the fresh-agent proof (required for a real run).
# Use a restricted, spend-limited key: it is written into each case sandbox.
ANTHROPIC_API_KEY=

# --- Stripe TEST MODE only (sk_test_...). Needs a meter whose event name is ahd_verified_fix
# (or set AHD_STRIPE_METER_EVENT_NAME), count aggregation, and a test customer id.
STRIPE_SECRET_KEY=
STRIPE_TEST_CUSTOMER_ID=

# --- Inkbox: approval texts. Without it, approve with POST /v1/approvals/reply.
INKBOX_API_KEY=
AHD_APPROVALS_FALLBACK_EMAIL=

# --- Primitive: fallback email intake
PRIMITIVE_KEY=

# --- Armature: install eval of the desk by a fresh agent
ARMATURE_KEY=

# --- Hosting the desk on Blaxel (demo/live.sh deploy). Optional: a token is generated if blank.
AHD_API_TOKEN=
# Optional overrides: AHD_DEPLOY_NAME=ahd-desk  AHD_DEPLOY_IMAGE=  AHD_DEPLOY_MEMORY_MB=4096
