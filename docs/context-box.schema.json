{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigi3d.github.io/AgentHelpDesk/context-box.schema.json",
  "title": "AHD context box",
  "description": "What a ticket carries so the desk can finish the goal, not just answer the error. Same shape for agents (structured) and humans (extracted from plain answers). Extends ProblemReport: `task` stays the one-line goal for back compat, `context` adds the rest.",
  "type": "object",
  "required": ["agent_id", "task", "channel", "context"],
  "properties": {
    "agent_id": { "type": "string", "maxLength": 200 },
    "task": { "type": "string", "maxLength": 500, "description": "Same as context.goal, one sentence." },
    "channel": { "enum": ["mcp", "email", "webhook", "forwarded"] },
    "requester_kind": { "enum": ["agent", "human"], "default": "agent" },
    "idempotency_key": { "type": "string", "maxLength": 200 },
    "context": {
      "type": "object",
      "required": ["goal", "attempted", "result"],
      "properties": {
        "goal": { "type": "string", "maxLength": 500, "description": "The outcome wanted, in one sentence." },
        "goal_source": { "enum": ["stated", "inferred", "confirmed"], "default": "stated", "description": "inferred = desk guessed it from the call trace; confirmed = requester agreed." },
        "step": { "type": "string", "maxLength": 300, "description": "Where in the plan the failure happened." },
        "attempted": {
          "type": "object",
          "required": ["request"],
          "properties": {
            "tool": { "type": "string" },
            "request": {}
          }
        },
        "result": {
          "type": "object",
          "required": ["response"],
          "properties": {
            "status": { "type": "integer" },
            "response": {}
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "api_version": { "type": "string" },
            "mcp_version": { "type": "string" },
            "framework": { "type": "string" },
            "model": { "type": "string" },
            "auth_state": { "enum": ["none", "valid", "expired", "insufficient_scope", "unknown"] }
          }
        },
        "already_tried": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20 },
        "constraints": {
          "type": "object",
          "properties": {
            "must_not": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
            "budget_usd": { "type": "number", "minimum": 0 },
            "deadline": { "type": "string", "format": "date-time" }
          }
        },
        "done_when": {
          "type": "object",
          "description": "The success check. The desk runs this against the vendor side, never the requester's word.",
          "required": ["check"],
          "properties": {
            "check": { "enum": ["http_status", "webhook", "state_query", "receipt", "human_confirm"] },
            "expect": {},
            "target": { "type": "string", "description": "URL, event name or query the check runs against." }
          }
        }
      }
    }
  }
}
